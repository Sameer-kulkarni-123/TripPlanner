# AI Trip Planning Agent Environment Variables

# Nuitee / LiteAPI credentials (https://docs.liteapi.travel/reference/authentication)
NUITEE_API_KEY=your_liteapi_key_here
NUITEE_API_BASE_URL=https://api.liteapi.travel/v3.0

# Itinerary Agent: fall back to offline demo activities when no live provider is configured
ITINERARY_DEMO_MODE=true

# Hotel Agent: max properties requested from /data/hotels per search
HOTEL_SEARCH_MAX_HOTELS=50

# LLM Providers (Configure whichever model provider you use)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-pro
# Gemini (free key at https://aistudio.google.com): reads "describe your trip" text and suggests
# activities when live Nuitee experiences are unavailable. Fallback models are tried if one isn't found.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash
ITINERARY_AI_ACTIVITIES=true

# Tavily web search (https://tavily.com): local tips from travellers, summarised by Gemini
TAVILY_API_KEY=
